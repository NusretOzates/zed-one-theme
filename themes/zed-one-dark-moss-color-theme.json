  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4a544c"
      }
    },
    {
      "name": "Doc Comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#889488"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.logical.python",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b08fc4"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#a8b4aa"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#9bc47a"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#889488"
      }
    },
    {
      "name": "String Regex / Special",
      "scope": [
        "string.regexp",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#d4a574"
      }
    },
    {
      "name": "Number / Boolean",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#d4a574"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#c9c078"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7eb8a8"
      }
    },
    {
      "name": "Constructor / Variant",
      "scope": [
        "entity.name.function.ctor"
      ],
      "settings": {
        "foreground": "#7eb8a8"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.namespace",
        "support.type",
        "support.class.builtin",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#d4b078"
      }
    },
    {
      "name": "Enum",
      "scope": [
        "entity.name.type.enum",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#d4b078"
      }
    },
    {
      "name": "Class / Struct",
      "scope": [
        "entity.name.class",
        "entity.name.struct",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#d4b078"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#a8b4aa"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#a8b4aa"
      }
    },
    {
      "name": "Special Variable",
      "scope": [
        "variable.language",
        "variable.other.special",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#d4a574"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.object.member"
      ],
      "settings": {
        "foreground": "#c48a8a"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#7dba8a"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7dba8a"
      }
    },
    {
      "name": "Selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#c9c078"
      }
    },
    {
      "name": "Pseudo Selector",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#7dba8a"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#a8b4aa"
      }
    },
    {
      "name": "Punctuation Bracket / Delimiter",
      "scope": [
        "punctuation.definition.parameters",
        "punctuation.section.brackets",
        "punctuation.definition.block",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#c4d0c6"
      }
    },
    {
      "name": "Punctuation Special",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#b06050"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#c8d4ca"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#7dba8a"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#c48a8a",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d4a574",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#7dba8a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#d4b078"
      }
    },
    {
      "name": "Markdown Link Text",
      "scope": [
        "meta.link.inline.markdown",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#7eb8a8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#9bc47a"
      }
    },
    {
      "name": "Markdown List Marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list"
      ],
      "settings": {
        "foreground": "#c48a8a"
      }
    },
    {
      "name": "Diff Added",
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#9bc47a"
      }
    },
    {
      "name": "Diff Removed",
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#c48a8a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c48a8a"
      }
    },
    {
      "name": "Language Constant (None/True/False)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#c9c078"
      }
    },
    {
      "name": "Class Type",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#d4b078"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#c8d4ca",
    "class": "#d4b078",
    "enum": "#d4b078",
    "interface": "#d4b078",
    "struct": "#d4b078",
    "type": "#d4b078",
    "typeParameter": "#d4b078",
    "parameter": "#a8b4aa",
    "variable": "#a8b4aa",
    "property": "#c48a8a",
    "enumMember": "#c9c078",
    "function": "#7eb8a8",
    "method": "#7eb8a8",
    "macro": "#b08fc4",
    "keyword": "#b08fc4",
    "modifier": "#b08fc4",
    "comment": "#4a544c",
    "string": "#9bc47a",
    "number": "#d4a574",
    "regexp": "#d4a574",
    "operator": "#a8b4aa",
    "decorator": "#7dba8a",
    "*.documentation": "#889488",
    "*.defaultLibrary": "#d4b078",
    "selfParameter": "#a8b4aa",
    "clsParameter": "#a8b4aa",
    "property.declaration": "#c48a8a",
    "class.declaration": "#d4b078",
    "constant": "#c9c078"
  }
}
