  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5d636f"
      }
    },
    {
      "name": "Doc Comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#878e98"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.logical.python",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b477cf"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#acb2be"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#a1c181"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#878e98"
      }
    },
    {
      "name": "String Regex / Special",
      "scope": [
        "string.regexp",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#bf956a"
      }
    },
    {
      "name": "Number / Boolean",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#bf956a"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#dfc184"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#73ade9"
      }
    },
    {
      "name": "Constructor / Variant",
      "scope": [
        "entity.name.function.ctor"
      ],
      "settings": {
        "foreground": "#73ade9"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.namespace",
        "support.type",
        "support.class.builtin",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#6eb4bf"
      }
    },
    {
      "name": "Enum",
      "scope": [
        "entity.name.type.enum",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#6eb4bf"
      }
    },
    {
      "name": "Class / Struct",
      "scope": [
        "entity.name.class",
        "entity.name.struct",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#6eb4bf"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#acb2be"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#acb2be"
      }
    },
    {
      "name": "Special Variable",
      "scope": [
        "variable.language",
        "variable.other.special",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#bf956a"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.object.member"
      ],
      "settings": {
        "foreground": "#d07277"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#74ade8"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#74ade8"
      }
    },
    {
      "name": "Selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#dfc184"
      }
    },
    {
      "name": "Pseudo Selector",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#74ade8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#acb2be"
      }
    },
    {
      "name": "Punctuation Bracket / Delimiter",
      "scope": [
        "punctuation.definition.parameters",
        "punctuation.section.brackets",
        "punctuation.definition.block",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#b2b9c6"
      }
    },
    {
      "name": "Punctuation Special",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#b1574b"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#dce0e5"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#74ade8"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#d07277",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#bf956a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#74ade8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#6eb4bf"
      }
    },
    {
      "name": "Markdown Link Text",
      "scope": [
        "meta.link.inline.markdown",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#73ade9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#a1c181"
      }
    },
    {
      "name": "Markdown List Marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list"
      ],
      "settings": {
        "foreground": "#d07277"
      }
    },
    {
      "name": "Diff Added",
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "name": "Diff Removed",
      "scope": [
        "markup.deleted",
        "diff.deleted"
