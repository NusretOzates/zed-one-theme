  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#a2a3a7" }
    },
    {
      "name": "Doc Comment",
      "scope": ["comment.block.documentation", "comment.line.documentation", "string.quoted.docstring"],
      "settings": { "foreground": "#7c7e86" }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#a449ab" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#3882b7" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#649f57" }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#7c7e86" }
    },
    {
      "name": "String Regex / Special",
      "scope": ["string.regexp", "constant.other.symbol"],
      "settings": { "foreground": "#ad6e26" }
    },
    {
      "name": "Number / Boolean",
      "scope": ["constant.numeric", "constant.language.boolean", "constant.language"],
      "settings": { "foreground": "#ad6e25" }
    },
    {
      "name": "Constant",
      "scope": ["constant", "variable.other.constant", "support.constant"],
      "settings": { "foreground": "#c18401" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#5b79e3" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type", "storage.type.primitive", "storage.type.built-in"],
      "settings": { "foreground": "#3882b7" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#242529" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#d3604f" }
    },
    {
      "name": "Special Variable",
      "scope": ["variable.language"],
      "settings": { "foreground": "#ad6e25" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#d3604f" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": { "foreground": "#5c78e2" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#5c78e2" }
    },
    {
      "name": "Selector",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#669f59" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": { "foreground": "#242529" }
    },
    {
      "name": "Punctuation Bracket / Delimiter",
      "scope": ["meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#4d4f52" }
    },
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#d3604f" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ad6e25", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#5c78e2", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#649f57" }
    },
    {
      "name": "Diff Added",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#50a14f" }
    },
    {
      "name": "Diff Removed",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#e45649" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#242529",
    "class": "#3882b7",
    "enum": "#3882b7",
    "interface": "#3882b7",
    "struct": "#3882b7",
    "type": "#3882b7",
    "parameter": "#d3604f",
    "variable": "#242529",
    "property": "#d3604f",
    "enumMember": "#c18401",
    "function": "#5b79e3",
    "method": "#5b79e3",
    "keyword": "#a449ab",
    "comment": "#a2a3a7",
    "string": "#649f57",
    "number": "#ad6e25",
    "operator": "#3882b7",
    "decorator": "#5c78e2",
    "*.documentation": "#7c7e86"
  }
}
