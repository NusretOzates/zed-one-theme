  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6e5e5e"
      }
    },
    {
      "name": "Doc Comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#928888"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.logical.python",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d08bb8"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#c4b8b8"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#a8c47a"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#928888"
      }
    },
    {
      "name": "String Regex / Special",
      "scope": [
        "string.regexp",
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#d4a574"
      }
    },
    {
      "name": "Number / Boolean",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#d4a574"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e0c080"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#e0a878"
      }
    },
    {
      "name": "Constructor / Variant",
      "scope": [
        "entity.name.function.ctor"
      ],
      "settings": {
        "foreground": "#e0a878"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.namespace",
        "support.type",
        "support.class.builtin",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#7eb8c9"
      }
    },
    {
      "name": "Enum",
      "scope": [
        "entity.name.type.enum",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#7eb8c9"
      }
    },
    {
      "name": "Class / Struct",
      "scope": [
        "entity.name.class",
        "entity.name.struct",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#7eb8c9"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#c4b8b8"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#c4b8b8"
      }
    },
    {
      "name": "Special Variable",
      "scope": [
        "variable.language",
        "variable.other.special",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#d4a574"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.object.member"
      ],
      "settings": {
        "foreground": "#e08a8a"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#e8917a"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#e8917a"
      }
    },
    {
      "name": "Selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#e0c080"
      }
    },
    {
      "name": "Pseudo Selector",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#e8917a"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#c4b8b8"
      }
    },
    {
      "name": "Punctuation Bracket / Delimiter",
      "scope": [
        "punctuation.definition.parameters",
        "punctuation.section.brackets",
        "punctuation.definition.block",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#cfc4c4"
      }
    },
    {
      "name": "Punctuation Special",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#c06050"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#e8e0e0"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#e8917a"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#e08a8a",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d4a574",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e8917a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7eb8c9"
      }
    },
    {
      "name": "Markdown Link Text",
      "scope": [
        "meta.link.inline.markdown",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#e0a878",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#a8c47a"
      }
    },
    {
      "name": "Markdown List Marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list"
      ],
      "settings": {
        "foreground": "#e08a8a"
      }
    },
    {
      "name": "Diff Added",
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#a8c47a"
      }
    },
    {
      "name": "Diff Removed",
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#e08a8a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e08a8a"
      }
    },
    {
      "name": "Language Constant (None/True/False)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#e0c080"
      }
    },
    {
      "name": "Class Type",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#7eb8c9"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#e8e0e0",
    "class": "#7eb8c9",
    "enum": "#7eb8c9",
    "interface": "#7eb8c9",
    "struct": "#7eb8c9",
    "type": "#7eb8c9",
    "typeParameter": "#7eb8c9",
    "parameter": "#c4b8b8",
    "variable": "#c4b8b8",
    "property": "#e08a8a",
    "enumMember": "#e0c080",
    "function": "#e0a878",
    "method": "#e0a878",
    "macro": "#d08bb8",
    "keyword": "#d08bb8",
    "modifier": "#d08bb8",
    "comment": "#6e5e5e",
    "string": "#a8c47a",
    "number": "#d4a574",
    "regexp": "#d4a574",
    "operator": "#c4b8b8",
    "decorator": "#e8917a",
    "*.documentation": "#928888",
    "*.defaultLibrary": "#7eb8c9",
    "selfParameter": "#c4b8b8",
    "clsParameter": "#c4b8b8",
    "property.declaration": "#e08a8a",
    "class.declaration": "#7eb8c9",
    "constant": "#e0c080"
  }
}
